    {
        "id": "2fe0cb81ccc2fcd2",
        "type": "function",
        "z": "cd69ce63c01563ea",
        "name": "Prepare Live Parking Log",
        "func": "const data = msg.payload;\n\nif (!data || ![1, 2, 3].includes(Number(data.slot))) {\n    return null;\n}\n\nconst slot = Number(data.slot);\nconst status = String(data.status);\nconst distance = Number(data.distance_cm);\nconst uptime = Number(data.uptime_ms);\n\nif (![\"AVAILABLE\", \"OCCUPIED\"].includes(status)) {\n    return null;\n}\n\nif (!Number.isFinite(distance) || !Number.isFinite(uptime)) {\n    return null;\n}\n\n// Only log status changes. Heartbeats repeat the same status every 10 s, and\n// filtering them here (in message order) avoids racing concurrent SQLite inserts.\nconst lastLogged = flow.get(\"lastLoggedStatus\") || {};\nif (lastLogged[slot] === status) {\n    return null;\n}\nlastLogged[slot] = status;\nflow.set(\"lastLoggedStatus\", lastLogged);\n\nmsg.topic =\n    \"INSERT INTO parking_logs \" +\n    \"(slot, status, distance_cm, uptime_ms, timestamp) VALUES (\" +\n    slot + \", '\" + status + \"', \" +\n    distance + \", \" + Math.trunc(uptime) +\n    \", datetime('now', 'localtime'));\";\n\nmsg.payload = [];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 620,
        "wires": [
            [
                "7aac14b8e703fd4e"
            ]
        ]

    {
        "id": "86cde05d27d26821",
        "type": "function",
        "z": "cd69ce63c01563ea",
        "name": "Parking Summary",
        "func": "\nconst slot = Number(msg.payload.slot);\nconst status = msg.payload.status;\n\nif (![1, 2, 3].includes(slot)) {\n    return null;\n}\n\nconst states = flow.get(\"parkingStates\") || {\n    1: \"UNKNOWN\",\n    2: \"UNKNOWN\",\n    3: \"UNKNOWN\"\n};\n\nstates[slot] = status;\nflow.set(\"parkingStates\", states);\n\nconst available = Object.values(states)\n    .filter(s => s === \"AVAILABLE\").length;\n\nconst occupied = Object.values(states)\n    .filter(s => s === \"OCCUPIED\").length;\n\nconst unknown = 3 - available - occupied;\n\n\nconst alert = occupied === 3\n    ? \"⚠ Alert: All parking slots occupied!\"\n    : \"\";\n\nmsg.payload =\n    \"Total Slots: 3\\n\" +\n    \"Available: \" + available + \"\\n\" +\n    \"Occupied: \" + occupied + \"\\n\" +\n    \"Unknown: \" + unknown +\n    (alert ? \"\\n\" + alert : \"\");\n\nmsg.available = available;\nmsg.occupied = occupied;\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 640,
        "wires": [
